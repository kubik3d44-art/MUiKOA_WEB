@page "/dashboard"
@layout AuthLayout
@rendermode InteractiveServer
@inject UserSessionService UserSession
@inject UserProfileService UserProfileService
@inject ReferenceDataService ReferenceDataService
@inject AdministrationService AdministrationService
@inject OperationalSectionService OperationalSectionService
@inject NavigationManager Navigation

<PageTitle>Панель @(CurrentUser?.Role ?? string.Empty)</PageTitle>

@if (CurrentUser is not null && profileModel is not null)
{
    <main class="dashboard-page">
        <aside class="dashboard-sidebar" aria-label="Разделы модуля">
            <h1>Разделы модуля</h1>
            <nav class="dashboard-nav">
                @foreach (var section in AvailableSections)
                {
                    <button class="dashboard-nav-item @(selectedSection == section && !isProfileOpen ? "active" : null)"
                            type="button"
                            @onclick="() => OpenSection(section)">
                        @section
                    </button>
                }
            </nav>
        </aside>

        <section class="dashboard-main">
            <div class="dashboard-actions">
                @if (!isProfileOpen)
                {
                    <div class="tool-panel" aria-label="Инструментарий">
                        @foreach (var tool in toolButtons)
                        {
                            <button type="button" @onclick="() => HandleToolActionAsync(tool)">@tool</button>
                        }
                    </div>
                }

                <div class="account-actions" aria-label="Навигация пользователя">
                    <button type="button" title="Домик" aria-label="Домик" @onclick="GoHome">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M3 11.5 12 4l9 7.5"></path>
                            <path d="M5 10.5V20h5v-5h4v5h5v-9.5"></path>
                        </svg>
                    </button>
                    <button type="button" title="Личный кабинет" aria-label="Личный кабинет" @onclick="OpenProfile">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M20 21a8 8 0 0 0-16 0"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </button>
                    <button type="button" title="Выход" aria-label="Выход" @onclick="Logout">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M10 17l5-5-5-5"></path>
                            <path d="M15 12H3"></path>
                            <path d="M21 3v18"></path>
                        </svg>
                    </button>
                </div>
            </div>

            @if (isProfileOpen)
            {
                @RenderProfile()
            }
            else
            {
                <section class="workspace-panel">
                    <div class="workspace-label">@WorkspaceTitle</div>

                    @if (IsInitialWorkspace)
                    {
                        <div class="warehouse-schema">
                            <img src="/img/schema_warehouse.png" alt="Схема склада" />
                        </div>
                    }
                    else if (selectedSection == "Справочники")
                    {
                        @RenderReferenceWorkspace()
                    }
                    else if (selectedSection == "Администрирование")
                    {
                        @RenderAdministrationWorkspace()
                    }
                    else if (sectionActionButtons.TryGetValue(selectedSection, out var actions))
                    {
                        @RenderOperationalWorkspace(actions)
                    }
                    else
                    {
                        <div class="section-placeholder">
                            <h2>@selectedSection</h2>
                        </div>
                    }
                </section>
            }
        </section>
    </main>
}

@code {
    private static readonly string[] toolButtons =
    [
        "Сохранить",
        "Изменить",
        "Сохранить и выйти",
        "Создать",
        "Создать группу",
        "Обновить"
    ];

    private static readonly Dictionary<string, string[]> roleSections = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Администратор"] = ["Справочники", "Администрирование", "Склад", "Документы", "Движение агрегатов", "Мониторинг состояния", "Отчёты"],
        ["Инженер"] = ["Справочники", "Документы", "Мониторинг состояния", "Отчёты"],
        ["Менеджер по снабжению"] = ["Справочники", "Склад", "Документы", "Движение агрегатов", "Отчёты"],
        ["Кладовщик"] = ["Справочники", "Документы", "Движение агрегатов"]
    };

    private const string WarehouseSection = "Схема склада";

    private static readonly string[] referenceButtons =
    [
        "Воздушные суда",
        "Агрегаты",
        "Типы местонахождений",
        "Единицы измерения",
        "Поставщики",
        "Изготовители",
        "Роли"
    ];

    private static readonly string[] adminButtons =
    [
        "Список пользователей",
        "Назначение ролей",
        "Роли и права доступа",
        "Структура склада",
        "Справочники",
        "Системная информация"
    ];

    private static readonly Dictionary<string, string[]> sectionActionButtons = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Склад"] = ["Остатки агрегатов", "Местонахождение агрегатов", "Зоны хранения", "Ячейки хранения"],
        ["Документы"] = ["Журнал документов", "Документы движения", "Заявки", "Приходные накладные", "Расходные накладные", "Акты"],
        ["Движение агрегатов"] = ["История движений", "Приход", "Расход", "Внутренние перемещения", "Списания"],
        ["Мониторинг состояния"] = ["Состояние агрегатов", "Контроль ресурсов", "Уведомления", "Контроль сроков"],
        ["Отчёты"] = ["Стоимостная оценка складских запасов", "История движения агрегата", "Списания за период", "План закупки"]
    };

    private string selectedSection = WarehouseSection;
    private bool isProfileOpen;
    private bool isProfileEditing;
    private bool isReferenceLoading;
    private bool isAdminLoading;
    private bool isOperationalLoading;
    private bool isAdminReferenceEditing;
    private bool isDocumentCreateOpen;
    private bool isIncomingInvoiceCreateOpen;
    private bool isRequestTypePickerOpen;
    private bool isInternalMovementRequestCreateOpen;
    private bool isRepairRequestCreateOpen;
    private bool isRequestEditOpen;
    private string? profileMessage;
    private string? documentCreateMessage;
    private string? incomingInvoiceMessage;
    private string? requestMessage;
    private string? selectedReference;
    private string? selectedAdminAction;
    private string? selectedOperationalAction;
    private string? selectedAdminReferenceTable;
    private string? searchText;
    private string? selectedDocumentTypeId;
    private string? selectedCreatorId;
    private string? selectedMovementTypeId;
    private string? selectedComponentInstanceId;
    private string? selectedZoneId;
    private string? selectedCellId;
    private string? reportDateFrom;
    private string? reportDateTo;
    private string? selectedComponentTypeId;
    private string? selectedPurchaseComponentId;
    private int purchasePlanQuantity = 1;
    private MUiKOA_WEB.Models.CreateDocumentModel createDocumentModel = new();
    private MUiKOA_WEB.Models.IncomingInvoiceModel incomingInvoiceModel = new();
    private MUiKOA_WEB.Models.InternalMovementRequestModel internalMovementRequestModel = new();
    private MUiKOA_WEB.Models.RepairRequestModel repairRequestModel = new();
    private MUiKOA_WEB.Models.GeneratedPurchasePlanDocument? generatedPurchasePlanDocument;
    private MUiKOA_WEB.Models.GeneratedPurchasePlanDocument? generatedStockValueDocument;
    private string? purchasePlanMessage;
    private IReadOnlyDictionary<string, object?>? selectedDocumentCard;
    private MUiKOA_WEB.Models.UserProfileEditModel? profileModel;
    private MUiKOA_WEB.Models.AdminUserCardModel? selectedUserCard;
    private MUiKOA_WEB.Models.EditableReferenceTable? editableReferenceTable;
    private IReadOnlyList<MUiKOA_WEB.Models.ReferenceGroup> referenceGroups = [];
    private IReadOnlyList<IReadOnlyDictionary<string, object?>> referenceRows = [];
    private IReadOnlyList<MUiKOA_WEB.Models.AdminUserListItem> adminUsers = [];
    private IReadOnlyList<MUiKOA_WEB.Models.RoleOption> roleOptions = [];
    private IReadOnlyList<MUiKOA_WEB.Models.SelectOption> documentTypeOptions = [];
    private IReadOnlyList<MUiKOA_WEB.Models.SelectOption> documentCreatorOptions = [];
    private IReadOnlyList<MUiKOA_WEB.Models.SelectOption> movementTypeOptions = [];
    private IReadOnlyList<MUiKOA_WEB.Models.SelectOption> componentOptions = [];
    private IReadOnlyList<MUiKOA_WEB.Models.SelectOption> zoneOptions = [];
    private IReadOnlyList<MUiKOA_WEB.Models.SelectOption> cellOptions = [];
    private IReadOnlyList<MUiKOA_WEB.Models.SelectOption> componentTypeOptions = [];
    private IReadOnlyList<MUiKOA_WEB.Models.SelectOption> purchaseComponentOptions = [];
    private List<MUiKOA_WEB.Models.PurchasePlanItem> purchasePlanItems = [];
    private IReadOnlyList<MUiKOA_WEB.Models.SelectOption> createDocumentTypeOptions = [];
    private IReadOnlyList<MUiKOA_WEB.Models.SelectOption> createComponentOptions = [];
    private IReadOnlyList<MUiKOA_WEB.Models.SelectOption> createComponentInstanceOptions = [];
    private IReadOnlyList<MUiKOA_WEB.Models.SelectOption> createLocationOptions = [];
    private IReadOnlyList<MUiKOA_WEB.Models.SelectOption> createUserOptions = [];
    private IReadOnlyList<MUiKOA_WEB.Models.SelectOption> createMovementTypeOptions = [];
    private IReadOnlyList<MUiKOA_WEB.Models.SelectOption> createSupplierOptions = [];
    private IReadOnlyList<MUiKOA_WEB.Models.SelectOption> repairRequestComponentOptions = [];
    private List<MUiKOA_WEB.Models.EditableRequestDocumentModel> editableRequestDocuments = [];
    private IReadOnlyList<(string TableName, string DisplayName)> adminReferenceCatalog = [];
    private IReadOnlyList<IReadOnlyDictionary<string, object?>> operationalRows = [];
    private MUiKOA_WEB.Models.LocationDirectoryData? locationData;
    private MUiKOA_WEB.Models.LocationDirectoryData? adminWarehouseData;

    private MUiKOA_WEB.Models.AuthenticatedUser? CurrentUser => UserSession.Session;

    private IReadOnlyList<string> AvailableSections =>
        CurrentUser is not null && roleSections.TryGetValue(CurrentUser.Role, out var sections)
            ? sections
            : [];

    private bool IsInitialWorkspace => selectedSection == WarehouseSection;

    private string WorkspaceTitle => IsInitialWorkspace ? WarehouseSection : selectedSection;

    private string DocumentActionColumnTitle => selectedSection == "Движение агрегатов" ? "Документ-основание" : "Карточка";

    private string DocumentActionButtonText => selectedSection == "Движение агрегатов" ? "Открыть основание" : "Открыть";

    protected override void OnInitialized()
    {
        var user = UserSession.InitializeFromHttpSession();

        if (user is null)
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        profileModel = UserProfileService.ToEditModel(user);
        adminReferenceCatalog = AdministrationService.GetEditableReferenceCatalog();
    }

    private void OpenSection(string section)
    {
        selectedSection = section;
        isProfileOpen = false;
        isProfileEditing = false;
        profileMessage = null;
        BackToReferenceMenu();
        BackToAdminMenu();
        BackToOperationalMenu();
    }

    private void OpenProfile()
    {
        isProfileOpen = true;
        isProfileEditing = false;
        profileMessage = null;

        if (CurrentUser is not null)
        {
            profileModel = UserProfileService.ToEditModel(CurrentUser);
        }
    }

    private RenderFragment RenderProfile() => @<section class="profile-panel">
        <div class="workspace-label">Личный кабинет</div>

        @if (!string.IsNullOrWhiteSpace(profileMessage))
        {
            <div class="profile-message">@profileMessage</div>
        }

        <div class="profile-toolbar">
            @if (isProfileEditing)
            {
                <button type="button" @onclick="CancelProfileEditing">Отменить редактирование</button>
                <button type="button" @onclick="SaveProfileAsync">Сохранить</button>
                <button type="button" @onclick="SaveProfileAndExitAsync">Сохранить и выйти</button>
            }
            else
            {
                <button type="button" @onclick="StartProfileEditing">Редактировать</button>
            }
        </div>

        <div class="profile-grid">
            @RenderProfileInput("firstName", "Имя", profileModel!.FirstName, value => profileModel!.FirstName = value ?? string.Empty)
            @RenderProfileInput("lastName", "Фамилия", profileModel!.LastName, value => profileModel!.LastName = value ?? string.Empty)
            @RenderProfileInput("middleName", "Отчество", profileModel!.MiddleName, value => profileModel!.MiddleName = value ?? string.Empty)
            <div class="profile-row"><label for="role">Роль</label><input id="role" value="@profileModel!.Role" disabled /></div>
            @RenderProfileInput("birthDate", "Дата рождения", profileModel!.BirthDate, value => profileModel!.BirthDate = value, "date")
            @RenderProfileInput("hireDate", "Дата трудоустройства", profileModel!.HireDate, value => profileModel!.HireDate = value, "date")
            @RenderProfileInput("terminationDate", "Дата увольнения", profileModel!.TerminationDate, value => profileModel!.TerminationDate = value, "date")
            @RenderProfileInput("phoneNumber", "Номер телефона", profileModel!.PhoneNumber, value => profileModel!.PhoneNumber = value ?? string.Empty)
            @RenderProfileInput("email", "Эл. почта", profileModel!.Email, value => profileModel!.Email = value ?? string.Empty, "email")
            @RenderProfileInput("password", "Пароль", profileModel!.Password, value => profileModel!.Password = value ?? string.Empty, "password")
        </div>
    </section>;

    private RenderFragment RenderProfileInput(string id, string label, string? value, Action<string?> setter, string type = "text") => @<div class="profile-row">
        <label for="@id">@label</label>
        <input id="@id" type="@type" value="@value" @onchange="args => setter(Convert.ToString(args.Value))" disabled="@(!isProfileEditing)" />
    </div>;

    private void StartProfileEditing()
    {
        isProfileEditing = true;
        profileMessage = null;
    }

    private void CancelProfileEditing()
    {
        isProfileEditing = false;
        profileMessage = null;

        if (CurrentUser is not null)
        {
            profileModel = UserProfileService.ToEditModel(CurrentUser);
        }
    }

    private async Task SaveProfileAsync() => await SaveProfileCoreAsync(closeProfile: false);

    private async Task SaveProfileAndExitAsync() => await SaveProfileCoreAsync(closeProfile: true);

    private async Task SaveProfileCoreAsync(bool closeProfile)
    {
        if (profileModel is null)
        {
            return;
        }

        await UserProfileService.UpdateAsync(profileModel);
        var updatedUser = await UserProfileService.GetByIdAsync(profileModel.Id);

        if (updatedUser is null)
        {
            profileMessage = "Не удалось обновить данные пользователя.";
            return;
        }

        UserSession.SetSession(updatedUser);
        profileModel = UserProfileService.ToEditModel(updatedUser);
        isProfileEditing = false;

        if (closeProfile)
        {
            GoHome();
        }
        else
        {
            profileMessage = "Данные сохранены.";
        }
    }

    private RenderFragment RenderReferenceWorkspace() => @<div class="reference-workspace">
        @if (selectedReference is null)
        {
            <div class="reference-menu">
                @foreach (var reference in referenceButtons)
                {
                    <button type="button" @onclick="() => OpenReferenceAsync(reference)">@reference</button>
                }
            </div>
        }
        else
        {
            <div class="reference-header">
                <button type="button" @onclick="BackToReferenceMenu">Назад к списку справочников</button>
            </div>
            @RenderReferenceContent(locationData, referenceGroups, referenceRows, isReferenceLoading)
        }
    </div>;

    private RenderFragment RenderAdministrationWorkspace() => @<div class="reference-workspace">
        @if (selectedAdminAction is null)
        {
            <div class="reference-menu">
                @foreach (var action in adminButtons)
                {
                    <button type="button" @onclick="() => OpenAdminActionAsync(action)">@action</button>
                }
            </div>
        }
        else
        {
            <div class="reference-header">
                <button type="button" @onclick="BackToAdminMenu">Назад к разделу администрирования</button>
            </div>

            @if (isAdminLoading)
            {
                <div class="reference-empty">Загрузка данных...</div>
            }
            else if (selectedAdminAction == "Список пользователей")
            {
                @RenderUserList()
            }
            else if (selectedAdminAction == "Назначение ролей")
            {
                @RenderRoleAssignment()
            }
            else if (selectedAdminAction == "Роли и права доступа")
            {
                @RenderRoleAccess()
            }
            else if (selectedAdminAction == "Структура склада")
            {
                <div class="warehouse-schema admin-schema"><img src="/img/schema_warehouse.png" alt="Схема склада" /></div>
                @RenderReferenceContent(adminWarehouseData, [], [], false)
            }
            else if (selectedAdminAction == "Справочники")
            {
                @RenderAdminReferences()
            }
            else if (selectedAdminAction == "Системная информация")
            {
                <div class="system-info">
                    <div><span>Название</span><strong>МУиКОА</strong></div>
                    <div><span>Версия</span><strong>1.0</strong></div>
                    <div><span>Год выпуска</span><strong>2026</strong></div>
                </div>
            }
        }
    </div>;

    private RenderFragment RenderOperationalWorkspace(string[] actions) => @<div class="reference-workspace">
        @if (selectedOperationalAction is null)
        {
            <div class="reference-menu">
                @foreach (var action in actions)
                {
                    <button type="button" @onclick="() => OpenOperationalActionAsync(action)">@action</button>
                }
            </div>
        }
        else
        {
            <div class="reference-header">
                <button type="button" @onclick="BackToOperationalMenu">Назад к разделу</button>
            </div>

            @if (selectedOperationalAction == "План закупки")
            {
                @RenderPurchasePlanList()
            }

            @RenderOperationalFilters()

            @if (isOperationalLoading)
            {
                <div class="reference-empty">Загрузка данных...</div>
            }
            else if (selectedOperationalAction == "План закупки")
            {
                @RenderPurchasePlanDocument()
            }
            else if (selectedOperationalAction is "Уведомления" or "Контроль сроков")
            {
                <div class="reference-empty">Раздел будет наполнен на следующем этапе.</div>
            }
            else
            {
                @if (HasDocumentCardColumn(operationalRows))
                {
                    @RenderDocumentRowsTable()
                }
                else
                {
                    @RenderReferenceTable(operationalRows)
                }
            }

            @if (selectedOperationalAction == "Стоимостная оценка складских запасов")
            {
                @RenderStockValueDocument()
            }

            @if (selectedDocumentCard is not null)
            {
                <div class="modal-backdrop-panel">
                    <div class="user-card-panel">
                        <div class="profile-toolbar">
                            <button type="button" @onclick="CloseDocumentCard">Закрыть</button>
                        </div>
                        @RenderDocumentCard(selectedDocumentCard)
                    </div>
                </div>
            }

            @if (isDocumentCreateOpen)
            {
                <div class="modal-backdrop-panel">
                    <div class="user-card-panel document-create-panel">
                        <div class="profile-toolbar">
                            <button type="button" @onclick="SaveCreatedDocumentAsync">Сохранить документ</button>
                            <button type="button" @onclick="CloseCreateDocumentForm">Закрыть</button>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(documentCreateMessage))
                        {
                            <div class="profile-message">@documentCreateMessage</div>
                        }

                        @RenderCreateDocumentForm()
                    </div>
                </div>
            }

            @if (isIncomingInvoiceCreateOpen)
            {
                <div class="modal-backdrop-panel">
                    <div class="user-card-panel document-create-panel">
                        <div class="profile-toolbar">
                            <button type="button" @onclick="SaveIncomingInvoiceAsync">Создать</button>
                            <button type="button" @onclick="CloseIncomingInvoiceForm">Закрыть</button>
                        </div>

                        <div class="workspace-label">Приходная накладная</div>

                        @if (!string.IsNullOrWhiteSpace(incomingInvoiceMessage))
                        {
                            <div class="profile-message">@incomingInvoiceMessage</div>
                        }

                        @RenderIncomingInvoiceForm()
                    </div>
                </div>
            }

            @if (isRequestTypePickerOpen)
            {
                <div class="modal-backdrop-panel">
                    <div class="user-card-panel document-create-panel">
                        <div class="profile-toolbar">
                            <button type="button" @onclick="CloseRequestTypePicker">Закрыть</button>
                        </div>

                        <div class="workspace-label">Выбор типа заявки</div>

                        @if (!string.IsNullOrWhiteSpace(requestMessage))
                        {
                            <div class="profile-message">@requestMessage</div>
                        }

                        <div class="reference-menu">
                            <button type="button" @onclick="OpenInternalMovementRequestForm">Заявка на внутреннее перемещение</button>
                            <button type="button" @onclick="OpenRepairRequestFormAsync">Заявка на ремонт агрегата</button>
                        </div>
                    </div>
                </div>
            }

            @if (isRepairRequestCreateOpen)
            {
                <div class="modal-backdrop-panel">
                    <div class="user-card-panel document-create-panel">
                        <div class="profile-toolbar">
                            <button type="button" @onclick="SaveRepairRequestAsync">Создать</button>
                            <button type="button" @onclick="CloseRepairRequestForm">Закрыть</button>
                        </div>

                        <div class="workspace-label">Заявка на ремонт агрегата</div>

                        @if (!string.IsNullOrWhiteSpace(requestMessage))
                        {
                            <div class="profile-message">@requestMessage</div>
                        }

                        @RenderRepairRequestForm()
                    </div>
                </div>
            }

            @if (isInternalMovementRequestCreateOpen)
            {
                <div class="modal-backdrop-panel">
                    <div class="user-card-panel document-create-panel">
                        <div class="profile-toolbar">
                            <button type="button" @onclick="SaveInternalMovementRequestAsync">Создать</button>
                            <button type="button" @onclick="CloseInternalMovementRequestForm">Закрыть</button>
                        </div>

                        <div class="workspace-label">Заявка на внутреннее перемещение</div>

                        @if (!string.IsNullOrWhiteSpace(requestMessage))
                        {
                            <div class="profile-message">@requestMessage</div>
                        }

                        @RenderInternalMovementRequestForm()
                    </div>
                </div>
            }

            @if (isRequestEditOpen)
            {
                <div class="modal-backdrop-panel">
                    <div class="user-card-panel document-create-panel">
                        <div class="profile-toolbar">
                            <button type="button" @onclick="SaveRequestDocumentsAsync">Сохранить</button>
                            <button type="button" @onclick="CloseRequestEditForm">Закрыть</button>
                        </div>

                        <div class="workspace-label">Изменение заявок</div>

                        @if (!string.IsNullOrWhiteSpace(requestMessage))
                        {
                            <div class="profile-message">@requestMessage</div>
                        }

                        @RenderRequestEditForm()
                    </div>
                </div>
            }
        }
    </div>;

    private RenderFragment RenderOperationalFilters() => @<div class="filter-panel">
        @if (selectedOperationalAction is "Местонахождение агрегатов")
        {
            <input placeholder="Поиск по агрегату или серийному номеру" value="@searchText" @onchange="args => searchText = Convert.ToString(args.Value)" />
            <select value="@selectedZoneId" @onchange="OnLocationZoneChangedAsync">
                <option value="">Все зоны</option>
                @foreach (var option in zoneOptions)
                {
                    <option value="@option.Value">@option.Text</option>
                }
            </select>
            <select value="@selectedCellId" @onchange="args => selectedCellId = Convert.ToString(args.Value)">
                <option value="">Все ячейки</option>
                @foreach (var option in cellOptions)
                {
                    <option value="@option.Value">@option.Text</option>
                }
            </select>
            <button type="button" @onclick="ReloadOperationalActionAsync">Найти</button>
        }
        else if (selectedOperationalAction is "Ячейки хранения")
        {
            <input placeholder="Поиск по серийному номеру или коду ячейки" value="@searchText" @onchange="args => searchText = Convert.ToString(args.Value)" />
            <button type="button" @onclick="ReloadOperationalActionAsync">Найти</button>
        }
        else if (selectedOperationalAction is "Журнал документов")
        {
            <select value="@selectedDocumentTypeId" @onchange="args => selectedDocumentTypeId = Convert.ToString(args.Value)">
                <option value="">Все типы документов</option>
                @foreach (var option in documentTypeOptions)
                {
                    <option value="@option.Value">@option.Text</option>
                }
            </select>
            <select value="@selectedCreatorId" @onchange="args => selectedCreatorId = Convert.ToString(args.Value)">
                <option value="">Все создатели</option>
                @foreach (var option in documentCreatorOptions)
                {
                    <option value="@option.Value">@option.Text</option>
                }
            </select>
            <button type="button" @onclick="ReloadOperationalActionAsync">Применить</button>
        }
        else if (selectedOperationalAction is "Документы движения" or "История движений")
        {
            <select value="@selectedMovementTypeId" @onchange="args => selectedMovementTypeId = Convert.ToString(args.Value)">
                <option value="">Все типы движения</option>
                @foreach (var option in movementTypeOptions)
                {
                    <option value="@option.Value">@option.Text</option>
                }
            </select>
            <input placeholder="Поиск по серийному номеру" value="@searchText" @onchange="args => searchText = Convert.ToString(args.Value)" />
            <button type="button" @onclick="ReloadOperationalActionAsync">Применить</button>
        }
        else if (selectedOperationalAction is "Стоимостная оценка складских запасов")
        {
            <button type="button" @onclick="GenerateStockValueDocumentAsync">Сформировать DOCX</button>
        }
        else if (selectedOperationalAction is "История движения агрегата")
        {
            <select value="@selectedComponentInstanceId" @onchange="args => selectedComponentInstanceId = Convert.ToString(args.Value)">
                <option value="">Все агрегаты</option>
                @foreach (var option in componentOptions)
                {
                    <option value="@option.Value">@option.Text</option>
                }
            </select>
            <button type="button" @onclick="ReloadOperationalActionAsync">Сформировать</button>
        }
        else if (selectedOperationalAction is "Списания за период")
        {
            <input type="date" value="@reportDateFrom" @onchange="args => reportDateFrom = Convert.ToString(args.Value)" />
            <input type="date" value="@reportDateTo" @onchange="args => reportDateTo = Convert.ToString(args.Value)" />
            <button type="button" @onclick="ReloadOperationalActionAsync">Сформировать</button>
        }
        else if (selectedOperationalAction is "План закупки")
        {
            <select value="@selectedComponentTypeId" @onchange="OnPurchaseComponentTypeChangedAsync">
                <option value="">Выберите тип агрегата</option>
                @foreach (var option in componentTypeOptions)
                {
                    <option value="@option.Value">@option.Text</option>
                }
            </select>
            <select value="@selectedPurchaseComponentId" @onchange="args => selectedPurchaseComponentId = Convert.ToString(args.Value)">
                <option value="">Выберите агрегат</option>
                @foreach (var option in purchaseComponentOptions)
                {
