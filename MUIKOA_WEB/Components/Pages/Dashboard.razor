            </select>
            <input type="number" min="1" step="1" placeholder="Количество к закупке" value="@purchasePlanQuantity" @onchange="SetPurchasePlanQuantity" />
            <button type="button" @onclick="AddPurchasePlanItemAsync">Добавить</button>
            <button type="button" @onclick="GeneratePurchasePlanDocumentAsync">Сформировать</button>
        }
    </div>;

