                "Приход" => await OperationalSectionService.GetDocumentsByMovementTypeAsync("Приход"),
                "Расход" => await OperationalSectionService.GetDocumentsByMovementTypeAsync("Расход"),
                "Внутренние перемещения" => await OperationalSectionService.GetDocumentsByMovementTypeAsync("Внутреннее перемещение"),
                "Списания" => await OperationalSectionService.GetWriteOffDocumentsAsync(),
                "Состояние агрегатов" => await OperationalSectionService.GetComponentConditionAsync(),
                "Контроль ресурсов" => await OperationalSectionService.GetResourceControlAsync(),
                "Стоимостная оценка складских запасов" => (await OperationalSectionService.GetStockValueReportAsync()).Rows,
                "История движения агрегата" => await OperationalSectionService.GetComponentMovementHistoryReportAsync(selectedComponentInstanceId),
                "Списания за период" => await OperationalSectionService.GetWriteOffsByPeriodAsync(reportDateFrom, reportDateTo),
