    }

    private static int? ParseNullableInt(object? value)
    {
        return int.TryParse(Convert.ToString(value), out var parsed) ? parsed : null;
    }

    private void AddEditableReferenceRow()
    {
        if (editableReferenceTable is null)
        {
            return;
        }

        var row = new MUiKOA_WEB.Models.EditableReferenceRow { IsNew = true };

        foreach (var column in editableReferenceTable.Columns)
        {
            row.Values[column.Name] = null;
        }

        editableReferenceTable.Rows.Insert(0, row);
    }

    private static string? GetEditableValue(MUiKOA_WEB.Models.EditableReferenceRow row, string column)
    {
        return row.Values.TryGetValue(column, out var value) ? value : null;
    }

    private static void SetEditableValue(MUiKOA_WEB.Models.EditableReferenceRow row, string column, string? value)
    {
        row.Values[column] = value;
    }

