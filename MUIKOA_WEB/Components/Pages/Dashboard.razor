    private RenderFragment RenderUserCardEditor(MUiKOA_WEB.Models.AdminUserCardModel user) => @<div class="profile-grid">
        @RenderTextEditor("Имя", user.FirstName, value => user.FirstName = value ?? string.Empty)
        @RenderTextEditor("Фамилия", user.LastName, value => user.LastName = value ?? string.Empty)
        @RenderTextEditor("Отчество", user.MiddleName, value => user.MiddleName = value ?? string.Empty)
        <div class="profile-row">
            <label>Роль</label>
            <select value="@user.RoleId" @onchange="args => user.RoleId = Convert.ToInt64(args.Value)">
                @foreach (var role in roleOptions)
                {
                    <option value="@role.Id">@role.Name</option>
                }
            </select>
        </div>
        @RenderTextEditor("Дата рождения", user.BirthDate, value => user.BirthDate = value, "date")
        @RenderTextEditor("Дата трудоустройства", user.HireDate, value => user.HireDate = value, "date")
        @RenderTextEditor("Дата увольнения", user.TerminationDate, value => user.TerminationDate = value, "date")
        @RenderTextEditor("Номер телефона", user.PhoneNumber, value => user.PhoneNumber = value ?? string.Empty)
        @RenderTextEditor("Эл. почта", user.Email, value => user.Email = value ?? string.Empty, "email")
        @RenderTextEditor("Пароль", user.Password, value => user.Password = value ?? string.Empty, "password")
    </div>;

