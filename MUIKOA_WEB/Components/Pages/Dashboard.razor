    private RenderFragment RenderReferenceContent(MUiKOA_WEB.Models.LocationDirectoryData? data, IReadOnlyList<MUiKOA_WEB.Models.ReferenceGroup> groups, IReadOnlyList<IReadOnlyDictionary<string, object?>> rows, bool isLoading) => @<div>
        @if (isLoading)
        {
            <div class="reference-empty">Загрузка данных...</div>
        }
        else if (data is not null)
        {
            @foreach (var warehouse in data.Warehouses)
            {
                <details class="reference-details">
                    <summary>@warehouse.Title</summary>
                    @foreach (var zone in warehouse.Zones)
                    {
                        <details class="reference-details nested">
                            <summary>@zone.Title</summary>
                            @foreach (var cell in zone.Cells)
                            {
                                <details class="reference-details nested">
                                    <summary>@cell.Title</summary>
                                    @RenderReferenceTable(cell.LocationRows)
                                </details>
                            }
                        </details>
                    }
                </details>
            }

            <details class="reference-details"><summary>Воздушные суда</summary>@RenderReferenceTable(data.AircraftLocations)</details>
            <details class="reference-details"><summary>Прочие местонахождения</summary>@RenderReferenceTable(data.OtherLocations)</details>
        }
        else if (groups.Count > 0)
        {
            @foreach (var group in groups)
            {
                <details class="reference-details">
                    <summary>@group.Title</summary>
                    @RenderReferenceTable(group.Rows)
                </details>
            }
        }
        else
        {
            @RenderReferenceTable(rows)
        }
    </div>;

    private RenderFragment RenderReferenceTable(IReadOnlyList<IReadOnlyDictionary<string, object?>> rows) => builder =>
    {
        if (rows.Count == 0)
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "reference-empty");
            builder.AddContent(2, "Записи отсутствуют.");
            builder.CloseElement();
            return;
        }

        var columns = rows.SelectMany(row => row.Keys).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        var sequence = 3;
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "reference-table-wrap");
        builder.OpenElement(sequence++, "table");
        builder.AddAttribute(sequence++, "class", "reference-table");
        builder.OpenElement(sequence++, "thead");
        builder.OpenElement(sequence++, "tr");

        foreach (var column in columns)
        {
            builder.OpenElement(sequence++, "th");
            builder.AddContent(sequence++, column);
            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(sequence++, "tbody");

        foreach (var row in rows)
        {
            builder.OpenElement(sequence++, "tr");
            if (IsStockTotalRow(row))
            {
                builder.AddAttribute(sequence++, "class", "stock-total-row");
            }

            foreach (var column in columns)
            {
                row.TryGetValue(column, out var value);
                builder.OpenElement(sequence++, "td");
                builder.AddContent(sequence++, FormatReferenceValue(value));
                builder.CloseElement();
            }

            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
    };

