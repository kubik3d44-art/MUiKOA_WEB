                    @foreach (var column in GetVisibleColumns(operationalRows, "ID документа"))
                    {
                        <th>@column</th>
                    }
                    <th>@DocumentActionColumnTitle</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in operationalRows)
                {
                    <tr>
                        @foreach (var column in GetVisibleColumns(operationalRows, "ID документа"))
                        {
                            row.TryGetValue(column, out var value);
                            <td>@FormatReferenceValue(value)</td>
                        }
                        <td>
                            @if (TryGetLong(row, "ID документа", out var documentId))
                            {
                                <button class="table-action-button" type="button" @onclick="() => OpenDocumentCardAsync(documentId)">@DocumentActionButtonText</button>
                            }
