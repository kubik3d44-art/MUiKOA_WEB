    private static string FormatReferenceValue(object? value)
    {
        return value switch
        {
            null => string.Empty,
            DateOnly dateOnly => dateOnly.ToString("dd.MM.yyyy"),
            DateTime dateTime => dateTime.ToString("dd.MM.yyyy"),
            bool boolean => boolean ? "Да" : "Нет",
            _ => Convert.ToString(value) ?? string.Empty
        };
    }

    private static string FormatMoney(decimal value)
    {
        return value.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("ru-RU"));
    }

    private static IReadOnlyList<string> GetVisibleColumns(IReadOnlyList<IReadOnlyDictionary<string, object?>> rows, params string[] hiddenColumns)
    {
        var hidden = hiddenColumns.ToHashSet(StringComparer.OrdinalIgnoreCase);
        return rows.SelectMany(row => row.Keys)
            .Where(column => !hidden.Contains(column))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static bool HasDocumentCardColumn(IReadOnlyList<IReadOnlyDictionary<string, object?>> rows)
    {
        return rows.Any(row => row.ContainsKey("ID документа"));
    }

    private static bool IsStockTotalRow(IReadOnlyDictionary<string, object?> row)
    {
        return row.TryGetValue("Показатель", out var value)
            && string.Equals(Convert.ToString(value), "Итого агрегатов на складе", StringComparison.OrdinalIgnoreCase);
    }

    private static bool TryGetLong(IReadOnlyDictionary<string, object?> row, string column, out long value)
    {
        value = 0;

        return row.TryGetValue(column, out var rawValue)
            && rawValue is not null
            && long.TryParse(Convert.ToString(rawValue), out value);
    }
