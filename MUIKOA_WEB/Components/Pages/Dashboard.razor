    private async Task HandleToolActionAsync(string tool)
    {
        if (selectedSection == "Документы" && tool == "Создать")
        {
            if (selectedOperationalAction == "Приходные накладные")
            {
                await OpenIncomingInvoiceFormAsync();
            }
            else if (selectedOperationalAction == "Заявки")
            {
                OpenRequestTypePicker();
            }
            else
            {
                await OpenCreateDocumentFormAsync();
            }

            return;
        }

        if (selectedSection == "Документы" && selectedOperationalAction == "Заявки" && tool == "Изменить")
        {
            await OpenRequestEditFormAsync();
            return;
        }

        if (selectedSection != "Администрирование" || selectedAdminAction != "Справочники" || editableReferenceTable is null)
        {
            return;
        }

        switch (tool)
        {
            case "Изменить":
                isAdminReferenceEditing = true;
                break;
            case "Создать":
                AddEditableReferenceRow();
                isAdminReferenceEditing = true;
                break;
            case "Сохранить":
                await AdministrationService.SaveEditableReferenceAsync(editableReferenceTable);
                editableReferenceTable = await AdministrationService.GetEditableReferenceAsync(editableReferenceTable.TableName);
                isAdminReferenceEditing = false;
                break;
            case "Обновить":
                editableReferenceTable = await AdministrationService.GetEditableReferenceAsync(editableReferenceTable.TableName);
                isAdminReferenceEditing = false;
                break;
        }
    }

