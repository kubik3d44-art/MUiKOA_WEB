    private async Task AddPurchasePlanItemAsync()
    {
        purchasePlanMessage = null;
        generatedPurchasePlanDocument = null;

        if (string.IsNullOrWhiteSpace(selectedComponentTypeId) || string.IsNullOrWhiteSpace(selectedPurchaseComponentId))
        {
            purchasePlanMessage = "Выберите тип агрегата и агрегат.";
            return;
        }

        var item = await OperationalSectionService.GetPurchasePlanItemAsync(selectedPurchaseComponentId, purchasePlanQuantity);

        if (item is null)
        {
            purchasePlanMessage = "Не удалось найти выбранный агрегат.";
            return;
        }

        var existingItem = purchasePlanItems.FirstOrDefault(planItem => planItem.ComponentId == item.ComponentId);

        if (existingItem is not null)
        {
            existingItem.Quantity += item.Quantity;
        }
        else
        {
            purchasePlanItems.Add(item);
        }

        purchasePlanQuantity = 1;
        selectedPurchaseComponentId = null;
    }

    private void UpdatePurchasePlanItemQuantity(long componentId, object? value)
    {
        var item = purchasePlanItems.FirstOrDefault(planItem => planItem.ComponentId == componentId);

        if (item is null)
        {
            return;
        }

        item.Quantity = int.TryParse(Convert.ToString(value), out var quantity) && quantity > 0
            ? quantity
            : 1;
        generatedPurchasePlanDocument = null;
    }

    private void RemovePurchasePlanItem(long componentId)
    {
        purchasePlanItems.RemoveAll(item => item.ComponentId == componentId);
        generatedPurchasePlanDocument = null;
    }

    private Task GeneratePurchasePlanDocumentAsync()
    {
        purchasePlanMessage = null;

        if (purchasePlanItems.Count == 0)
        {
            purchasePlanMessage = "Добавьте хотя бы один агрегат в план закупки.";
            generatedPurchasePlanDocument = null;
            return Task.CompletedTask;
        }

        generatedPurchasePlanDocument = OperationalSectionService.GeneratePurchasePlanDocument(purchasePlanItems);
        return Task.CompletedTask;
    }

